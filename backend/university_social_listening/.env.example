# ==============================================================================
# UP Voice Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Database Connection (MySQL or TiDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=university_social_listening
DB_SSL=false

# JWT Authentication
SECRET_KEY=dev-secret-key-up-voice-senior-project-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# WangchanBERTa NLP Model Path
# Relative to backend/university_social_listening or absolute path
WANGCHAN_MODEL_DIR=./models/finetuned_model

# Local LLM (Ollama) - Optional for advanced content analysis
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=neural-chat

# Upload Storage
IMAGE_UPLOAD_DIR=./uploads/images
MAX_IMAGE_SIZE_MB=20

# Server Environment
DEBUG=False
