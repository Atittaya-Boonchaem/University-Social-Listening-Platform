# ==============================================================================
# UP Voice — Docker Environment Configuration Template
# คัดลอกเนื้อหานี้ไปวางในไฟล์: backend/university_social_listening/.env
# ==============================================================================

# Database Connection (TiDB Cloud / MySQL)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=university_social_listening
DB_SSL=true

# JWT Authentication
SECRET_KEY=dev-secret-key-up-voice-senior-project-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Email Services (Brevo / SMTP)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
BREVO_API_KEY=your_brevo_api_key

# Microsoft SSO OAuth2
SSO_TENANT_ID=your_sso_tenant_id
SSO_CLIENT_ID=your_sso_client_id
SSO_CLIENT_SECRET=your_sso_client_secret
SSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback

# AI / LLM (Typhoon API by SCB 10X)
TYPHOON_API_KEY=your_typhoon_api_key

# Upload Storage (Inside Docker container will map to local folder)
IMAGE_UPLOAD_DIR=./uploads/images
MAX_IMAGE_SIZE_MB=20

# Server Environment
DEBUG=False

